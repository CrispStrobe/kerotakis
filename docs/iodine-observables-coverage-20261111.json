{
  "schema": "kerotakis/iodine-observables-coverage-v1",
  "solvent": "hexane",
  "counts": {
    "ion-stays-aqueous": 40,
    "neutral-refused": 147,
    "partitions": 9
  },
  "cases": [
    {
      "id": "new120:sp-011",
      "observable": "hexane extraction of a thiosulfate-reduced iodine feed",
      "status": "fixed",
      "mechanism": "ion-only feeds are extracted: hexane dispensed, ions kept aqueous and named (Extracted.retained via ion_partition, EN/DE/FR); residual I2, if any, partitions with the existing reviewed K = 85 row",
      "tests": [
        "separation_receivers::ions_alone_are_extracted_as_nothing_and_kept_in_the_water",
        "separation_receivers::ions_beside_an_unparameterised_neutral_still_refuse_and_dispense_nothing"
      ]
    },
    {
      "id": "batch2:ki-011",
      "observable": "iodine-clock delay vs thiosulfate sink within 100 s; UV-vis with colloidal sulfur",
      "status": "refusal-kept; kinetics fixed (see docs/iodine-clock-kinetics-coverage-20261111.md)",
      "mechanism": "UV-vis refusal for sulfur (not-modeled.unreviewed-molar-absorptivity) is kept: colloidal sulfur scatters and no reviewed extinction exists. The clock is now the measured two-term law rate = (k0 + k1[H+])[H2O2][I-], k0 = 0.69 L/mol/min, k1 = 10.5 L2/mol2/min at 25 C (Liebhafsky & Mohammad, J. Am. Chem. Soc. 55 (1933) 3977-3986, doi:10.1021/ja01337a010), and the iodide-catalysed `peroxide-decomposition` branch stands down while the clock rows can run (one owner of H2O2 + I- in acid).",
      "tests": [
        "iodide_peroxide_two_term::ki011_gross_iodine_meets_each_sink_at_the_hand_computed_time",
        "iodide_peroxide_two_term::acid_iodide_peroxide_has_one_owner_no_catalytic_oxygen"
      ]
    },
    {
      "id": "batch3-diverse:en-001",
      "observable": "starch-triiodide absorbance; amylase digestion over the wait",
      "status": "refusal-kept; enzyme-rate data gap recorded",
      "mechanism": "not-modeled.starch-iodine-absorptivity kept: no primary molar absorptivity for the amylose-triiodide complex could be sourced and verified. Amylase hydrolysis is a curated instantaneous reaction; a Michaelis-Menten route needs a cited kcat/Km for the enzyme preparation, not available, so it is recorded rather than tuned.",
      "tests": []
    }
  ],
