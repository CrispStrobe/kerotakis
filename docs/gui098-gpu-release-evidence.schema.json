{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerotakis.invalid/schemas/gui098-gpu-release-evidence.schema.json",
  "title": "GUI-098 GPU release evidence",
  "type": "object",
  "required": ["schemaVersion", "candidate", "hosts", "similarityReview"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidate": {
      "type": "object",
      "required": ["commit", "buildArtifact", "measuredAt"],
      "properties": {
        "commit": { "type": "string", "minLength": 7 },
        "buildArtifact": { "type": "string", "minLength": 1 },
        "measuredAt": { "type": "string", "format": "date-time" }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/host" }
    },
    "similarityReview": { "$ref": "#/$defs/review" }
  },
  "$defs": {
    "host": {
      "type": "object",
      "required": ["platform", "device", "os", "runtime", "gpu", "power", "payload", "coldStartupMs", "cpuFrameMs", "rafJank", "fallback", "artifacts", "reviewer", "reviewedAt"],
      "properties": {
        "platform": { "enum": ["web", "android", "ios", "macos", "windows"] },
        "device": { "type": "object", "required": ["manufacturer", "model", "physical"] },
        "os": { "type": "object", "required": ["name", "version", "build"] },
        "runtime": { "type": "object", "required": ["kind", "name", "version"] },
        "gpu": { "type": "object", "required": ["vendor", "model", "driver"] },
        "power": { "type": "object", "required": ["source", "mode"] },
        "payload": {
          "type": "object",
          "required": ["rawBytes", "gzipBytes", "baselineGzipBytes"],
          "properties": {
            "rawBytes": { "type": "integer", "minimum": 0 },
            "gzipBytes": { "type": "integer", "minimum": 0 },
            "baselineGzipBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "coldStartupMs": { "$ref": "#/$defs/timing" },
        "cpuFrameMs": { "allOf": [{ "$ref": "#/$defs/timing" }, { "required": ["max"] }] },
        "rafJank": { "type": "object", "required": ["frames", "missedFrames", "longFrames"] },
        "fallback": {
          "type": "object",
          "required": ["webGpuAbsent", "compileFailure", "deviceLoss", "headless", "background", "reducedMotion"]
        },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "timing": {
      "type": "object",
      "required": ["samples", "p50", "p95"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "review": {
      "type": "object",
      "required": ["method", "result", "reviewer", "reviewedAt", "artifacts"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "result": { "const": "independent" },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  }
}
