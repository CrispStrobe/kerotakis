/target
**/*.rs.bk
Cargo.lock
!web/app/src-tauri/Cargo.lock
.DS_Store
.env
/dist
/build
node_modules/
__pycache__/
*.wasm
!/crates/**/vendor/**/*.wasm
error.inp
phreeqc.log
.claude/worktrees/
data/registry/registry.pack
data/dbindex/
tools/oracle/cache/
tools/oracle/output/
THIRD_PARTY_LICENSES.html

# App Store Connect signing material. The .p8 API key and any provisioning
# profile fetched with it are secrets tied to the developer account, and a
# committed one is a compromised one.
.appstoreconnect/
*.p8
*.p12
*.mobileprovision
*.provisionprofile
web/app/node_modules

# Snapshot suites write the regenerated file beside the golden so a failure
# can be judged rather than guessed. It is an artefact, never a commit.
*.actual.json

# The mutation harness's scratch: pristine copies of the files it perturbs, a
# catalogue, verdicts, and the marker that says a falsified constant is live on
# disk right now. Never committed — a mutated source in a commit is the exact
# accident tools/mutation/mutate.py's recovery guard exists to prevent.
.mutation-state/
