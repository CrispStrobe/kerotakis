# D3-AD-001: A filter does not remove a dissolved dye by itself
# Simulation candidate; no runtime observations are claimed.
register lv3
new
new
new
add v1 water 50mL
add v1 methyl_orange 0.005g
add v1 activated_charcoal 0.10g
add v2 water 50mL
add v2 methyl_orange 0.005g
measure v1 uvvis
measure v2 uvvis
filter v1 v3
filter v2 v4
measure v3 uvvis
measure v4 uvvis
look v1
inspect
