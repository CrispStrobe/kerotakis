# D3-EN-001: Starch digestion: sample before adding the iodine indicator
# Simulation candidate; no runtime observations are claimed.
register lv3
new
new
add v1 water 50mL @ 37C
add v1 starch 0.20g
add v1 amylase 0.010g
add v2 water 50mL @ 37C
add v2 starch 0.20g
add v3 water 50mL @ 37C
add v3 maltose 0.20g
wait 20min
add v1 KI 0.0001mol
add v2 KI 0.0001mol
add v3 KI 0.0001mol
add v1 I2 0.00002mol
add v2 I2 0.00002mol
add v3 I2 0.00002mol
measure v1 uvvis
measure v2 uvvis
measure v3 uvvis
inspect
