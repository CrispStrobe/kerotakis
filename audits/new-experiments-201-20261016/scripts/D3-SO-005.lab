# D3-SO-005: Ionic solids do not all have the same solubility in a dry organic solvent
# Simulation candidate; no runtime observations are claimed.
register lv3
new
new
add v1 ethanol 20mL
add v1 NaCl 0.5g
add v2 ethanol 20mL
add v2 CaCl2 0.5g
add v3 propanone 20mL
add v3 NaCl 0.5g
stir v1 300rpm 20s
stir v2 300rpm 20s
stir v3 300rpm 20s
look v1
look v2
look v3
particles v1
particles v2
inspect
