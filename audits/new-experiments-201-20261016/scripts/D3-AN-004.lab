# D3-AN-004: Vitamin C can hide starch from an iodine test
# Simulation candidate; no runtime observations are claimed.
register lv3
new
new
add v1 water 40mL
add v1 starch 0.10g
add v1 ascorbic_acid 0.00003mol
add v2 water 40mL
add v2 starch 0.10g
add v3 water 40mL
add v3 ascorbic_acid 0.00003mol
add v1 KI 0.0001mol
add v2 KI 0.0001mol
add v3 KI 0.0001mol
add v1 I2 0.00002mol
add v2 I2 0.00002mol
add v3 I2 0.00002mol
measure v1 uvvis
measure v2 uvvis
measure v3 uvvis
add v1 I2 0.00005mol
measure v1 uvvis
particles v1
inspect
