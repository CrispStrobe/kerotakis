# D3-FO-003: A formulation can contain both a gas source and a starch-test target
# Simulation candidate; no runtime observations are claimed.
register lv3
new
add v1 water 40mL
add v1 baking_powder 0.5g
add v2 water 40mL
add v2 NaHCO3 0.15g
add v1 KI 0.0001mol
add v2 KI 0.0001mol
add v1 I2 0.00002mol
add v2 I2 0.00002mol
measure v1 uvvis
measure v2 uvvis
particles v1
particles v2
inspect
