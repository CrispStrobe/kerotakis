+fn require_context_free_record(row: &Value, key: &str, property: &str) -> Result<(), String> {
+    let conditions = &row["quantity"]["conditions"];
+    for field in ["temperature", "pressure", "ph", "ionic_strength", "medium"] {
+        if !conditions[field].is_null() {
+            return Err(format!(
+                "{key}: {property} requires {field} context for runtime fallback"
+            ));
+        }
+    }
+    let condition_phase = &conditions["phase"];
+    if !condition_phase.is_null() && condition_phase != &row["phase"] {
+        return Err(format!(
+            "{key}: {property} condition phase conflicts with runtime record phase"
+        ));
+    }
+    Ok(())
+}
