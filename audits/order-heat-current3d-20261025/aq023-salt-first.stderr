--- PHREEQC input ---
SOLUTION 1
    units     mol/kgw
    temp      25.0000
    pH        7  charge
    water     9.9699999999999997e-2
    pe        4  O2(g)  -0.68
    Ca 1.003009027081e-1
    Cl 2.006018054162e-1
EQUILIBRIUM_PHASES 1
    Portlandite 0 0.000000000000e0
SELECTED_OUTPUT
    -reset    false
    -high_precision true
    -ph       true
    -pe       true
    -ionic_strength true
    -water    true
    -activities H2O
    -totals   Ca Cl
    -equilibrium_phases Portlandite
    -molalities H+ OH-
USER_PUNCH 1
    -headings particle_molality
    -start
10 particles = SYS("aq", count, names$, types$, amounts)
20 PUNCH particles / TOT("water")
    -end
END
