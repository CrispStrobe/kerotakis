    C 1.419513096409e-1
    Na 2.839026192818e-1
EQUILIBRIUM_PHASES 1
    CO2(g) -3.408 0.000000000000e0
    Nahcolite 0 0.000000000000e0
SELECTED_OUTPUT
    -reset    false
    -high_precision true
    -ph       true
    -pe       true
    -ionic_strength true
    -water    true
    -activities H2O
    -totals   C Na C(-4)
