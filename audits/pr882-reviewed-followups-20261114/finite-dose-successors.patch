+// Successor to the two frozen blanket-Dose refusal cases. The independently
+// certified FE003 route now supports an owned finite gas dose beside a signed
+// clock. Input gas is not proof of an unowned or surviving post-solve parcel.
+// Unknown stock, an unsupported phase and overdraw must still refuse atomically.
+fn opaque_clock_seed(plant: bool) -> Vessel {
+    let mut bench = Bench::new();
+    let mut solver = stack();
+    let commands: &[&str] = if plant {
+        &["add v1 leaf 1g", "add v1 water 100mL", "add v1 CO2 0.01mol"]
+    } else {
+        &[
+            "add v1 protein 1g",
+            "add v1 water 100mL",
+            "add v1 NaOH 0.01mol",
+            "add v1 pepsin 0.001mol",
+        ]
+    };
+    for command in commands {
+        step(&mut bench, &mut solver, command);
+    }
+    bench.vessel(VesselId(0)).unwrap().clone()
+}
+
+#[test]
+fn finite_owned_bio_gas_and_each_clock_sign_have_one_certified_boundary() {
+    for plant in [false, true] {
+        for sign in [-1.0, 1.0] {
+            let mut vessel = opaque_clock_seed(plant);
+            vessel.deposit(SpeciesId::new("CO2"), Moles(0.001), Phase::Gas);
+            let clock = sign * 2.0 * CO2_TRANSFER_FLOOR_MOL;
+            vessel.pending_co2_transfer_mol = clock;
+            let before = vessel.clone();
+            let mut native = PhreeqcEquilibrator::new().expect("native adapter");
+            let events = native
+                .equilibrate(&mut vessel)
+                .expect("owned dose and clock must close");
+            assert_co2_boundary(&before, &vessel, &events, clock > 0.0);
+            assert_eq!(
+                vessel
+                    .contents
+                    .iter()
+                    .filter(|p| p.species.0 == "CO2" && p.phase == Phase::Gas)
+                    .map(|p| p.moles.0)
+                    .sum::<f64>(),
+                0.0
+            );
+            let clock_events = events
+                .iter()
+                .filter(|event| match event {
+                    Event::GasAbsorbed { species, moles, .. } if clock > 0.0 => {
+                        species.0 == "CO2" && moles.0.to_bits() == clock.to_bits()
+                    }
+                    Event::GasEvolved { species, moles, .. } if clock < 0.0 => {
+                        species.0 == "CO2" && moles.0.to_bits() == (-clock).to_bits()
+                    }
+                    _ => false,
+                })
+                .count();
+            assert_eq!(
+                clock_events, 1,
+                "the signed parcel must be emitted exactly once"
+            );
+            let after_first = vessel.clone();
+            native.equilibrate(&mut vessel).expect("zero-time reentry");
+            assert_eq!(vessel.pending_co2_transfer_mol, 0.0);
+            assert_eq!(
+                after_first.unresolved_materials,
+                vessel.unresolved_materials
+            );
+            assert_eq!(
+                immutable_spectators(&after_first),
+                immutable_spectators(&vessel)
+            );
+            let a = known_ledger(&after_first);
+            let b = known_ledger(&vessel);
+            for element in a.elements.keys().chain(b.elements.keys()) {
+                assert!(
+                    (a.elements.get(element).copied().unwrap_or(0.0)
+                        - b.elements.get(element).copied().unwrap_or(0.0))
+                    .abs()
+                        <= 1e-10,
+                    "{element}: zero-time replay must not spend either parcel again"
+                );
+            }
+            assert!((a.charge - b.charge).abs() <= 1e-10);
+        }
+    }
+}
