+#[test]
+fn finite_bio_dose_cannot_hide_unknown_stock_wrong_phase_or_clock_overdraw() {
+    for plant in [false, true] {
+        let seed = opaque_clock_seed(plant);
+        for invalid in 0..3 {
+            let mut vessel = seed.clone();
+            vessel.deposit(
+                SpeciesId::new("CO2"),
+                Moles(0.001),
+                if invalid == 1 {
+                    Phase::Liquid
+                } else {
+                    Phase::Gas
+                },
+            );
+            vessel.pending_co2_transfer_mol = if invalid == 2 {
+                -1.0
+            } else {
+                2.0 * CO2_TRANSFER_FLOOR_MOL
+            };
+            if invalid == 0 {
+                vessel.deposit(
+                    SpeciesId::new("unknown_clock_stock"),
+                    Moles(0.001),
+                    Phase::Solid,
+                );
+            }
+            let snapshot = serde_json::to_value(&vessel).unwrap();
+            PhreeqcEquilibrator::new()
+                .expect("native adapter")
+                .equilibrate(&mut vessel)
+                .expect_err("finite dose cannot certify an unsupported owner or overdraw");
+            assert_eq!(serde_json::to_value(&vessel).unwrap(), snapshot, "plant={plant}, invalid={invalid}: refusal must retain complete stock and pending parcel");
+        }
+    }
+}
