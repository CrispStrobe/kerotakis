--- PHREEQC input ---
SOLUTION 1
    units     mol/kgw
    temp      25.0000
    pH        7  charge
    water     9.9699999999999997e-2
GAS_PHASE_RAW 1
    -type 1
    -total_p 4.000113770191e-4
    -volume 1.000000000000e-1
    -temperature 2.981500000000e2
    -new_def 0
    -solution_equilibria 0
    -total_moles 1.634961780973e-6
    -component CO2(g)
        -moles 1.634961780973e-6
USE gas_phase 1
SELECTED_OUTPUT
    -reset    false
    -high_precision true
    -ph       true
    -pe       true
    -ionic_strength true
    -water    true
    -activities H2O
    -totals   C C(-4)
    -gases    CO2(g)
    -molalities H+ OH- CO2 H2CO3 HCO3- CO3-2
USER_PUNCH 1
    -headings particle_molality
    -start
10 particles = SYS("aq", count, names$, types$, amounts)
20 PUNCH particles / TOT("water")
    -end
END
