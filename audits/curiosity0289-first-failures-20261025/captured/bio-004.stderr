    -high_precision true
    -ph       true
    -pe       true
    -ionic_strength true
    -water    true
    -activities H2O
    -totals   Acetate C Na
    -equilibrium_phases CO2(g)
    -molalities H+ OH- H(Acetate) Acetate- CO2 H2CO3 HCO3- CO3-2
USER_PUNCH 1
    -headings particle_molality
    -start
10 particles = SYS("aq", count, names$, types$, amounts)
20 PUNCH particles / TOT("water")
    -end
END
