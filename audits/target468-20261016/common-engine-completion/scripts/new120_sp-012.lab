# SP-012: Chromatography distinguishes dissolved neutral solutes without consuming the sample
# Candidate experiment; expected observations are not measured results.
register lv3
add v1 water 100mL
add v1 ethanol 0.001mol
add v1 ethyl_acetate 0.001mol
add v1 glucose 0.001mol
inspect v1
measure v1 chromatograph
inspect v1
