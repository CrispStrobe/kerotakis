# RX-007: Vitamin C has finite reducing capacity: iodine eventually persists
# Candidate experiment; expected observations are not measured results.
register lv3
add v1 water 100mL
add v1 ascorbic_acid 0.0001mol
add v1 KI 0.001mol
add v1 I2 0.00005mol
inspect v1
add v1 I2 0.00005mol
inspect v1
add v1 I2 0.00005mol
inspect v1
measure v1 uvvis
inspect
