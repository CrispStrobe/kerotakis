# AB-011: Equal buffer pH does not mean equal buffer capacity
# Candidate experiment; expected observations are not measured results.
register lv3
add v1 water 100mL
add v1 CH3COOH 0.0002mol
add v1 NaOAc 0.0002mol
measure v1 ph
new
add v2 water 100mL
add v2 CH3COOH 0.002mol
add v2 NaOAc 0.002mol
measure v2 ph
add v1 HCl 0.0001mol
add v2 HCl 0.0001mol
measure v1 ph
measure v2 ph
inspect
