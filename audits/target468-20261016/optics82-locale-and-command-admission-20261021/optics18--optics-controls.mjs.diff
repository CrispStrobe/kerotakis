+// Only source-reviewed non-mutating worker commands are allowed after scene.
+// Unknown future commands HOLD; they are never guessed read-only.
+const POST_SCENE_READ_ONLY = new Set(["balance_exercise", "balance_mark", "balance_reveal", "calc", "catalog", "element_coverage", "grammar", "hello", "inspect", "parse", "parse_legacy", "particles", "relations", "scene", "snapshot", "species", "state"]);
+function assertProtocolCommandAdmission(entries, scene, protocol) {
+  assert(protocol.length > 0, 'owned prescribed protocol absent');
+  const allowed = new Set();
+  for (const pair of protocol) {
+    assert(pair.origin === 'app' && pair.worker === scene.worker && ['set_register','run_script'].includes(pair.request.cmd) && pair.response.type === 'done', 'prescribed protocol owner/type differs');
+    const q = entries.filter(e => e.sequence === pair.request_sequence && e.worker === pair.worker && e.direction === 'request' && e.origin === 'app');
+    const r = entries.filter(e => e.sequence === pair.response_sequence && e.worker === pair.worker && e.direction === 'response');
+    assert.equal(q.length, 1); assert.equal(r.length, 1);
+    assert.deepEqual(q[0].value, pair.request); assert.deepEqual(r[0].value, pair.response);
+    assert(pair.response.id === pair.request.id && pair.request_sequence < pair.response_sequence, 'prescribed protocol terminal differs');
+    const key = `${pair.worker}:${pair.request.id}:${pair.request_sequence}`;
+    assert(!allowed.has(key), 'duplicate prescribed request'); allowed.add(key);
+  }
+  const start = protocol[0].request_sequence;
+  for (const e of entries.filter(e => e.sequence >= start && e.direction === 'request')) {
+    assert(e.origin === 'app' || e.origin === 'observer-read-only-snapshot' || e.origin === 'observer-read-only-scene', 'unknown protected request owner');
+    if (e.origin === 'app') {
+      const key = `${e.worker}:${e.value.id}:${e.sequence}`;
+      assert(allowed.has(key) || POST_SCENE_READ_ONLY.has(e.value.cmd), 'unprescribed mutation or unknown protected command: HOLD');
+    } else assert(e.origin === 'observer-read-only-' + e.value.cmd && ['snapshot','scene'].includes(e.value.cmd) && e.value.id < 0, 'protected observer command is not owned read-only');
+  }
+}
+function assertPostSceneCommands(entries, scene) {
+  const terminal = entries.filter(e => e.sequence === scene.response_sequence && e.worker === scene.worker && e.direction === 'response' && e.value.id === scene.request.id && e.value.type === 'done');
+  assert.equal(terminal.length, 1, 'owned final scene terminal missing');
+  for (const e of entries.filter(e => e.sequence > scene.response_sequence && e.direction === 'request')) {
+    assert(e.origin === 'app' || e.origin === 'observer-read-only-snapshot' || e.origin === 'observer-read-only-scene', 'unknown trailing request owner');
+    if (e.origin === 'app') assert(POST_SCENE_READ_ONLY.has(e.value.cmd), 'late mutating or unknown app command: HOLD');
+    else assert(e.origin === 'observer-read-only-' + e.value.cmd && ['snapshot','scene'].includes(e.value.cmd) && e.value.id < 0, 'observer trailing command is not owned read-only');
+  }
+}
