From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kerotakis <cze@mailbox.org>
Date: Sun, 31 Aug 2026 00:00:00 +0000
Subject: [PATCH 2/2] mol2000: don't state a valence an aromatic bond cannot
 support, and let the valence tests actually read the atom line

Two follow-ups to the valence/isotope patch, both found by running its
tests.

* The tests were reading the wrong line. `atom_line(molfile, n)` took
  `lines().nth(3 + n)`, but line 3 is the counts line and the atom block
  starts at line 4. So `atom_line(m, 0)` handed back
  "  1  0  0  0 ...999 V2000", and the three valence assertions were
  indexing columns 48..51 of a 39-character string, or reading atom n-1.
  With the off-by-one fixed they exercise the writer and pass.

* `valence_code` stated a valence that an aromatic bond cannot support.
  `bond_order_sum` reaches `BondOrder::order_int`, which folds Aromatic
  -- and every query order -- to 1. For a bracket atom that *understates*
  the total: an aromatic carbon carrying one hydrogen has a total valence
  of 4, and the sum says 2 + 1 = 3. Writing 3 is worse than writing
  nothing, because a reader computing
  `num_H = max(0, vvv - chem_bonds_valence)` can then drop the hydrogen
  entirely. `0` -- "use the default valence" -- is the honest answer
  wherever the field cannot state the truth, and it is the same
  abstention organic-subset atoms already get.

  This is reachable, not theoretical: the SMILES parser preserves
  `BondOrder::Aromatic` rather than kekulising on parse (its own
  `test_parse_benzene_aromatic` asserts exactly that), so any aromatic
  SMILES with a bracket atom reaches it -- `[13cH]1ccccc1` among them,
  which is precisely the isotope-labelled spelling the previous patch
  enables.

A column-integrity test is added alongside: the valence field is written
*into* the fixed-width atom line, so the symbol and charge columns must
still land where they always did and the line must still be 66 wide.

Verified: `cargo test --lib mol2000` -> 51 passed, 0 failed.
---
 crates/chematic-mol/src/mol2000.rs | 69 ++++++++++++++++++++++++++++--
 1 file changed, 67 insertions(+), 2 deletions(-)

diff --git a/crates/chematic-mol/src/mol2000.rs b/crates/chematic-mol/src/mol2000.rs
--- a/crates/chematic-mol/src/mol2000.rs
+++ b/crates/chematic-mol/src/mol2000.rs
@@ -614,6 +614,27 @@
     let Some(h) = mol.atom(idx).hydrogen_count else {
         return 0;
     };
+    // An aromatic or query bond order has no integer valence to contribute.
+    // `order_int` folds every one of them to 1, which *understates* the
+    // atom's true valence -- an aromatic carbon carrying one hydrogen totals
+    // 4, not the 2+1 this would sum. Writing that number is worse than
+    // writing nothing: `0` ("use the default valence") is the honest answer
+    // wherever the field cannot state the truth.
+    let integral = |order| {
+        matches!(
+            order,
+            BondOrder::Single
+                | BondOrder::Up
+                | BondOrder::Down
+                | BondOrder::Dative
+                | BondOrder::Double
+                | BondOrder::Triple
+                | BondOrder::Quadruple
+        )
+    };
+    if mol.neighbors(idx).any(|(_, b)| !integral(mol.bond(b).order)) {
+        return 0;
+    }
     let total = u16::from(bond_order_sum(mol, idx)) + u16::from(h);
     match total {
         0 => 15,
@@ -1688,7 +1709,7 @@
     // ---- CAP-13: what a coordinate-less bracket atom has to be able to say ----
 
     fn atom_line(molfile: &str, n: usize) -> String {
-        molfile.lines().nth(3 + n).expect("atom line").to_string()
+        molfile.lines().nth(4 + n).expect("atom line").to_string()
     }
 
     /// `[Mg]` is elemental magnesium, not MgH2. The only V2000 channel that
@@ -1723,6 +1744,50 @@
         assert_eq!(&atom_line(&molfile, 0)[48..51], "  0");
     }
 
+    /// An aromatic bond has no integer order to sum, so a bracket atom
+    /// carrying one cannot state a total valence -- and must not guess.
+    ///
+    /// `bond_order_sum` counts every aromatic bond as 1, which understates
+    /// the valence of an aromatic bracket atom: an aromatic carbon with one
+    /// explicit hydrogen has a total valence of 4, but two aromatic bonds
+    /// plus one H sums to 3. Writing `3` is worse than writing nothing --
+    /// `0` means "use the default valence", which is exactly the right
+    /// answer for an atom whose valence this field cannot express.
+    #[test]
+    fn an_aromatic_bracket_atom_declines_to_state_a_valence() {
+        let mut b = MoleculeBuilder::new();
+        let mut c = Atom::new(Element::C);
+        c.hydrogen_count = Some(1);
+        let c = b.add_atom(c);
+        let n1 = b.add_atom(Atom::new(Element::C));
+        let n2 = b.add_atom(Atom::new(Element::C));
+        b.add_bond(c, n1, BondOrder::Aromatic).unwrap();
+        b.add_bond(c, n2, BondOrder::Aromatic).unwrap();
+        let mol = b.build();
+        let molfile = write_mol(&mol, &MolMetadata::default());
+        assert_eq!(
+            &atom_line(&molfile, 0)[48..51],
+            "  0",
+            "aromatic bonds have no integer valence to sum"
+        );
+    }
+
+    /// The valence field is written *into* the fixed-width atom line, not
+    /// appended to it: every other field must land where it always did.
+    #[test]
+    fn the_valence_field_does_not_disturb_the_other_atom_columns() {
+        let mol = chematic_smiles::parse("[Mg+2]").expect("parse");
+        let molfile = write_mol(&mol, &MolMetadata::default());
+        let line = atom_line(&molfile, 0);
+        assert_eq!(&line[31..34], "Mg ", "symbol columns");
+        assert_eq!(&line[36..39], "  2", "MDL charge code for +2");
+        assert_eq!(&line[48..51], " 15", "zero-valence sentinel");
+        assert_eq!(line.len(), 66, "V2000 atom line width is unchanged");
+        let (reparsed, _) = parse_mol(&molfile).expect("round-trips");
+        assert_eq!(reparsed.atom(AtomIdx(0)).charge, 2);
+        assert_eq!(reparsed.atom(AtomIdx(0)).element, Element::MG);
+    }
+
     /// Heavy water is not water. The atom line's mass-difference field
     /// cannot carry an arbitrary label, so `M  ISO` has to.
     #[test]
