    Thiocyanate Thiocyanate- 0 58.078 58.078
SOLUTION_SPECIES
    Thiocyanate- = Thiocyanate-
        log_k 0
    Cu+2 + NH3 = CuNH3+2
        log_k 4.0
    Cu+2 + 2 NH3 = Cu(NH3)2+2
        log_k 7.5
    Cu+2 + 3 NH3 = Cu(NH3)3+2
        log_k 10.3
    Cu+2 + 4 NH3 = Cu(NH3)4+2
        log_k 11.8
    Fe+3 + Thiocyanate- = Fe(Thiocyanate)+2
        log_k 3.0
    Fe+3 + 2 Thiocyanate- = Fe(Thiocyanate)2+
        log_k 3.6
