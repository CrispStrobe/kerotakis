RATES
FastDecay
-start
10 rate = PARM(1) * M * TIME
20 IF rate > M THEN rate = M
30 SAVE rate
-end
SlowDecay
-start
10 rate = PARM(1) * M * TIME
20 IF rate > M THEN rate = M
30 SAVE rate
-end
SOLUTION 1
    pH 7
KINETICS 1
    FastDecay
        -formula H2O 0
        -m 1
        -m0 1
        -parms 1.0
        -tol 1e-12
    SlowDecay
        -formula H2O 0
        -m 1
        -m0 1
        -parms 0.1
        -tol 1e-12
    -steps 0.5 0.5 1.0 seconds
SELECTED_OUTPUT
    -reset false
    -high_precision true
    -kinetics FastDecay SlowDecay
END
