{
  "id": "./",
  "name": "Kerotakis — a chemistry bench that computes",
  "short_name": "Kerotakis",
  "description": "A virtual chemistry laboratory that computes real chemistry — PHREEQC solving in your browser, offline.",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#14120f",
  "theme_color": "#14120f",
  "categories": ["education", "science", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The bench, the shelf and the notebook side by side, with silver chloride settling out."
    },
    {
      "src": "screenshot-narrow.png",
      "sizes": "860x1864",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The same experiment on a phone, one pane at a time."
    }
  ],
  "shortcuts": [
    {
      "name": "The console",
      "short_name": "Console",
      "description": "The same engine as a terminal — type verbs, read the ledger.",
      "url": "./",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
