<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store requires the sandbox. Kerotakis is a genuinely
         offline app: the engine is linked into the binary and every
         lesson, database and codex entry ships inside the bundle, so no
         network entitlement of any kind appears below. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Open a .lab script; save a session, a notebook, a chart. Both
         directions go through the system open/save panel, which is what
         this entitlement covers and the only filesystem reach the app has. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- The notebook prints; that is the PDF export path (GUI-022). -->
    <key>com.apple.security.print</key>
    <true/>
</dict>
</plist>
