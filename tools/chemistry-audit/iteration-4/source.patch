+fn open_fizz_balance_equals_inputs_minus_escaped_gas() {
+    let lesson = lessons_dir().join("sealed-mass-conservation.lab");
+    let (out, err, ok) = run(&["run", lesson.to_str().unwrap(), "--json"]);
+    assert!(ok, "{err}");
