<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Kerotakis Third-Party Licenses</title>
<style>body{font-family:system-ui,sans-serif;max-width:80ch;margin:2em auto}
h1{border-bottom:2px solid #333;padding-bottom:.3em}
details{margin:1em 0}summary{cursor:pointer;font-weight:bold}
pre{background:#f5f5f5;padding:1em;overflow-x:auto;font-size:.85em;white-space:pre-wrap}</style>
</head><body>
<h1>Third-Party Licenses</h1>
<p>Kerotakis includes the following third-party components.</p>
{{#each licenses}}
<details>
<summary>{{name}} ({{id}})</summary>
<p>Used by:</p><ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>
{{/each}}</ul>
<pre>{{text}}</pre>
</details>
{{/each}}
</body></html>
